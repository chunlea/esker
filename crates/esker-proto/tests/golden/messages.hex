# TxnKv (service 0x02): Get 0x0201, Scan 0x0202, Prewrite 0x0203, Commit 0x0204,
# Rollback 0x0205, ResolveLock 0x0206, Heartbeat 0x0207, GcSafepoint 0x0208. Every one
# carries the same region header as a RawKv request. A ResolveLock commit_ts of zero
# means roll back: no transaction commits at timestamp zero, so the slot is free.
#
# Commit and Rollback answer with a status byte and, for the two that name a timestamp, a
# varint: Ok 1, Conflict 2 ++ commit_ts, RolledBack 3, Committed 4 ++ commit_ts,
# LockNotFound 5. Prewrite answers with a *count* and one status per mutation, and only a
# Prewrite result may carry Locked 6 ++ key ++ primary ++ start_ts ++ ttl_ms — a batch can
# collide with several locks and one refusal cannot describe many keys.
request txn-get 010201020304036b65792a
request txn-scan 0202010203040161017a642a00
request txn-scan-reverse 0202010203040161017a642a01
request txn-prewrite 0302010203042a0170b817020101610131020162
request txn-commit 0402010203042a320201610162
request txn-rollback 0502010203042a010161
request txn-resolve-commit 0602010203042a3200
request txn-resolve-rollback 0602010203042a00010161
request txn-heartbeat 0702010203042a0170b817
request txn-gc-safepoint 080201020304808080808040
request admin-split 010503016d
request admin-transfer-leader 02050307
request admin-regions 0305

response txn-get 0102010176
response txn-get-absent 010200
response txn-scan 02020101610131
response txn-prewrite 0302020101
response txn-prewrite-locked 0302030106096163636f756e742f31096163636f756e742f30808080808040b81706096163636f756e742f32096163636f756e742f30808080808040b817
response txn-prewrite-conflict 0302010232
response txn-prewrite-rolledback 03020103
response txn-prewrite-empty 030200
response txn-commit 040201
response txn-commit-lock-lost 040205

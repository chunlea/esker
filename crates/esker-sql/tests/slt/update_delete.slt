# UPDATE and DELETE, and the index entries that have to move with them.

statement ok
CREATE TABLE u (id int8 PRIMARY KEY, e text UNIQUE, n int8 NOT NULL)

# tag: INSERT 0 3
statement ok
INSERT INTO u VALUES (1, 'a', 10), (2, 'b', 20), (3, NULL, 30)

# tag: UPDATE 1
statement ok
UPDATE u SET n = 99 WHERE id = 1

query I
SELECT n FROM u WHERE id = 1
----
99

# tag: UPDATE 3
statement ok
UPDATE u SET n = 0

# tag: UPDATE 0
statement ok
UPDATE u SET n = 1 WHERE id = 999

# A SET expression sees the row as it was, so this swaps rather than assigning twice.
statement ok
CREATE TABLE swap (id int8 PRIMARY KEY, a int8, b int8)

statement ok
INSERT INTO swap VALUES (1, 10, 20)

# tag: UPDATE 1
statement ok
UPDATE swap SET a = b, b = a WHERE id = 1

query II
SELECT a, b FROM swap
----
20	10

# The index moves with the value: the old entry must not answer for it.
statement ok
UPDATE u SET e = 'z' WHERE id = 1

query I
SELECT id FROM u WHERE e = 'z'
----
1

query I
SELECT id FROM u WHERE e = 'a'
----

# And the freed value can be taken.
statement ok
UPDATE u SET e = 'a' WHERE id = 2

query I
SELECT id FROM u WHERE e = 'a'
----
2

statement error (23505)
UPDATE u SET id = 3 WHERE id = 1

statement error (23505)
UPDATE u SET e = 'a' WHERE id = 3

statement error (23502)
UPDATE u SET n = NULL WHERE id = 1

statement error (42703)
UPDATE u SET nope = 1

statement error (22P02)
UPDATE u SET n = 'x' WHERE id = 1

# Setting a unique column to what it already is is not a duplicate of itself.
# tag: UPDATE 1
statement ok
UPDATE u SET e = 'a', n = 5 WHERE id = 2

# Moving a row's key moves the row.
# tag: UPDATE 1
statement ok
UPDATE u SET id = 10 WHERE id = 1

query I
SELECT id FROM u ORDER BY id
----
2
3
10

# tag: DELETE 0
statement ok
DELETE FROM u WHERE id = 999

# tag: DELETE 1
statement ok
DELETE FROM u WHERE id = 2

# The index entry went with the row, so the value is free.
statement ok
INSERT INTO u VALUES (99, 'a', 1)

# tag: DELETE 3
statement ok
DELETE FROM u

query I
SELECT id FROM u
----

# CREATE INDEX and DROP INDEX, including the part that is easy to get wrong: an index over a table
# that already has rows has to be built, not just declared.

statement ok
CREATE TABLE t (id int8 PRIMARY KEY, a text, b int8)

# tag: INSERT 0 3
statement ok
INSERT INTO t VALUES (1, 'x', 10), (2, 'y', 20), (3, 'z', 30)

# Built over rows that already exist, so the lookup finds them.
# tag: CREATE INDEX
statement ok
CREATE UNIQUE INDEX t_a_key ON t (a)

query I
SELECT id FROM t WHERE a = 'y'
----
2

# A derived name is disambiguated; a name the user chose is not.
statement ok
CREATE INDEX ON t (b)

statement ok
CREATE INDEX ON t (b)

statement ok
CREATE INDEX mine ON t (b)

statement error (42P07)
CREATE INDEX mine ON t (b)

# tag: CREATE INDEX
statement ok
CREATE INDEX IF NOT EXISTS mine ON t (b)

# tag: DROP INDEX
statement ok
DROP INDEX t_b_idx1

statement error (42704)
DROP INDEX t_b_idx1

statement ok
DROP INDEX IF EXISTS t_b_idx1

statement error (42809)
DROP INDEX t

# The primary key's index cannot be dropped: the constraint needs it.
statement error (2BP01)
DROP INDEX t_pkey

# A unique index built over rows that already break it fails, with the same code an INSERT gets.
statement ok
CREATE TABLE dupes (id int8 PRIMARY KEY, v text)

# tag: INSERT 0 2
statement ok
INSERT INTO dupes VALUES (1, 'same'), (2, 'same')

statement error (23505)
CREATE UNIQUE INDEX dupes_v_key ON dupes (v)

statement ok
CREATE INDEX dupes_v_idx ON dupes (v)

# --- CREATE INDEX CONCURRENTLY, as a staged job --------------------------------------------------
# ADR 0020, docs/plans/phase-6e.md. PostgreSQL's own distinction between the two forms: the plain
# one builds inside the statement and the concurrent one does not hold the table against writers,
# paying for it in time and in being able to leave nothing behind if it fails. Here that is four
# states and a batched backfill, and `esker_schema_step` is the step with the wait taken out --
# which is what makes the state machine testable without a timer.
#
# The statement drives its own build and answers when it is finished, which is PostgreSQL's
# contract (tests/invalid_index.rs); `stage` is the half of esker.concurrent_index_build that
# leaves the job for a driver, and it is the half this section is about.

statement ok
SET esker.concurrent_index_build = 'stage'

statement ok
CREATE TABLE cj (id int8 PRIMARY KEY, a int8)

statement ok
INSERT INTO cj VALUES (1, 10), (2, 20)

statement ok
CREATE UNIQUE INDEX CONCURRENTLY cji ON cj (a)

# The statement returns at once, with the index at absent: nothing reads it yet.
query TTTTT rowsort
SELECT * FROM esker_schema_jobs()
----
cj	adding	cji	absent	not started

# One step per state, in the ADR's order. Each of these three is a transition, and a driver waits
# PD's published interval after each; the backfill batches between them change no state and wait
# for nothing.
query T
SELECT esker_schema_step('cji')
----
delete-only

query T
SELECT esker_schema_step('cji')
----
write-only

# The backfill, then public. Two rows fit in one batch, so the batch is followed by the transition.
query T
SELECT esker_schema_step('cji')
----
backfilling

query T
SELECT esker_schema_step('cji')
----
public

# A finished job is forgotten, and the index answers.
query TTTTT rowsort
SELECT * FROM esker_schema_jobs()
----

query I
SELECT id FROM cj WHERE a = 20
----
2

# --- DROP INDEX CONCURRENTLY, the removal direction ----------------------------------------------
# The same four states, walked backwards, and nothing is removed until the last step. The three
# state moves are bounded by a *writer* one step behind, like an adding change; the final removal is
# bounded by a *reader*, which is where the retention term in PD's step interval goes live
# (ADR 0020 as amended, docs/plans/phase-6e.md §1).

statement ok
DROP INDEX CONCURRENTLY cji

query TTTTT rowsort
SELECT * FROM esker_schema_jobs()
----
cj	removing	cji	public	backfilled

query T
SELECT esker_schema_step('cji')
----
write-only

query T
SELECT esker_schema_step('cji')
----
delete-only

query T
SELECT esker_schema_step('cji')
----
absent

# Only now, and this is the step a driver waits the retention window before: at absent nothing reads
# the index and nothing writes it, so what is taken away is something no live transaction can want.
query T
SELECT esker_schema_step('cji')
----
dropped

query TTTTT rowsort
SELECT * FROM esker_schema_jobs()
----

# The table still answers, out of itself.
query I
SELECT id FROM cj WHERE a = 20
----
2

# PostgreSQL refuses either concurrent form inside a transaction block, and so does this: a
# concurrent change is many transactions, so it cannot be part of one.
statement ok
BEGIN

statement error (25001)
CREATE INDEX CONCURRENTLY cjk ON cj (a)

statement ok
ROLLBACK

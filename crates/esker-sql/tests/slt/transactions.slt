# BEGIN, COMMIT, ROLLBACK -- including DDL, which is transactional here as it is in PostgreSQL and
# is not in every database.

statement ok
CREATE TABLE t (id int8 PRIMARY KEY, n int8)

statement ok BEGIN
BEGIN

statement ok
INSERT INTO t VALUES (1, 10)

# The transaction sees its own writes.
query I
SELECT n FROM t WHERE id = 1
----
10

statement ok ROLLBACK
ROLLBACK

query I
SELECT n FROM t WHERE id = 1
----

statement ok BEGIN
BEGIN

statement ok
INSERT INTO t VALUES (1, 10)

statement ok
UPDATE t SET n = 11 WHERE id = 1

statement ok COMMIT
COMMIT

query I
SELECT n FROM t WHERE id = 1
----
11

# DDL rolls back too.
statement ok
BEGIN

statement ok
CREATE TABLE gone (id int8 PRIMARY KEY)

statement ok
ROLLBACK

statement error 42P01
SELECT * FROM gone

# Several statements in one block, committed together.
statement ok
BEGIN

statement ok
CREATE TABLE together (id int8 PRIMARY KEY)

statement ok
INSERT INTO together VALUES (1), (2)

statement ok
DELETE FROM together WHERE id = 1

statement ok
COMMIT

query I
SELECT id FROM together
----
2

# A statement outside a block is its own transaction, so a failure leaves nothing -- not even the
# rows before the one that failed.
statement error 23505
INSERT INTO t (id, n) VALUES (2, 1), (1, 1)

query I
SELECT id FROM t ORDER BY id
----
1

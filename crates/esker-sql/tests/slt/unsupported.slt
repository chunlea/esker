# Contract C2: a statement PostgreSQL accepts and this node does not run comes back `0A000` naming
# the construct. Never a syntax error, never a wrong answer, never a silent no-op.
#
# This file is the deliverable §3 calls "out, as executed features -- and therefore in as C2
# responses". Every line here parses.

statement ok
CREATE TABLE t (id int8 PRIMARY KEY, a int8, b text)

# A table alias runs now (phase 9 unit 5, tests/alias.rs). What it brought within reach and is
# still not a feature names itself: a **column** alias list renames the table's columns, and
# ignoring it would answer a query about `c` with a column called `id`.
statement error (0A000)
SELECT c FROM t AS x (c)

statement error (0A000)
SELECT * FROM t UNION SELECT * FROM t

# `GROUP BY`, `HAVING`, `DISTINCT` and the five aggregates run now (phase 9 unit 1,
# tests/slt/aggregate.slt). What sits next to them still does not, and each still names itself.
statement error (0A000)
SELECT a FROM t GROUP BY ROLLUP (a)

statement error (0A000)
SELECT a FROM t GROUP BY GROUPING SETS ((a), ())

statement error (0A000)
SELECT DISTINCT ON (a) a FROM t

statement error (0A000)
WITH x AS (SELECT 1) SELECT * FROM x

statement error (0A000)
SELECT count(*) OVER () FROM t

statement error (0A000)
SELECT count(*) FILTER (WHERE a > 0) FROM t

statement error (0A000)
SELECT avg(a) FROM t

statement error (0A000)
SELECT a + 1 FROM t


statement error (0A000)
INSERT INTO t VALUES (1, 2, 'x') ON CONFLICT DO NOTHING

statement error (0A000)
INSERT INTO t SELECT * FROM t

statement error (0A000)
CREATE TEMPORARY TABLE tmp (id int8 PRIMARY KEY)

statement error (0A000)
CREATE TABLE copy AS SELECT * FROM t

# `DEFAULT <constant>` runs now (alter_table.slt); a volatile one does not, for the reason a
# volatile one on ADD COLUMN does not.
statement error (0A000)
CREATE TABLE d (id int8 PRIMARY KEY, a float8 DEFAULT random())

statement error (0A000)
CREATE TABLE f (id int8 PRIMARY KEY, a int8, FOREIGN KEY (a) REFERENCES t (id))

statement error (0A000)
CREATE TABLE c (id int8 PRIMARY KEY, a int8, CHECK (a > 0))

# `int4`, `int2`, `varchar` and `timestamp` run since ADR 0033; what is left of tier 1 is refused by
# name, in the order that ADR gives them, and each line goes when its type lands.
statement error (0A000)
CREATE TABLE tv (id int8 PRIMARY KEY, a varchar(10))

statement error (0A000)
CREATE TABLE tr (id int8 PRIMARY KEY, a real)

statement error (0A000)
CREATE TABLE tp (id int8 PRIMARY KEY, a timestamp(3))

statement error (0A000)
CREATE TABLE public.q (id int8 PRIMARY KEY)

statement error (0A000)
CREATE INDEX ON t (a) WHERE a > 0


# `ALTER TABLE ADD COLUMN` runs for a nullable column and for one with a **constant** default
# (see alter_table.slt). What is left is what would need a row rewritten, and each is named rather
# than lumped together.
#
# `NOT NULL` with no default: nothing to pad the rows already stored with. The refusal names the
# pair, because `NOT NULL DEFAULT 7` is accepted.
statement error (0A000)
ALTER TABLE t ADD COLUMN c int8 NOT NULL

# A volatile default differs per row, so it cannot be one constant in the catalog. PostgreSQL
# rewrites the table for it; this node has no rewrite yet and says so.
statement error (0A000)
ALTER TABLE t ADD COLUMN r float8 DEFAULT random()

# PostgreSQL folds this to 2 before storing it. There is no folder here.
statement error (0A000)
ALTER TABLE t ADD COLUMN e int8 DEFAULT (1+1)

statement error (0A000)
ALTER TABLE t ADD COLUMN c int8 UNIQUE

statement error (0A000)
ALTER TABLE t ADD COLUMN c int8 PRIMARY KEY

statement error (0A000)
ALTER TABLE t DROP COLUMN a

statement error (0A000)
ALTER TABLE t RENAME COLUMN a TO b

statement error (0A000)
ALTER TABLE t ALTER COLUMN a TYPE text

statement error (0A000)
ALTER TABLE t RENAME TO t2

statement error (0A000)
ALTER TABLE ONLY t ADD COLUMN c int8

statement error (0A000)
CREATE VIEW v AS SELECT * FROM t

statement error (0A000)
PREPARE p AS SELECT 1

statement error (0A000)
COPY t FROM STDIN

statement error (0A000)
GRANT SELECT ON t TO alice

# And the statement after any of them still runs: a refusal is not a poisoned session.
query I
SELECT 1
----
1

# ALTER TABLE ADD COLUMN, which is the whole of ALTER TABLE that this node executes.
#
# The point of the feature is what it does *not* do: no row is rewritten. A row written before the
# column existed says how many columns it holds, so it reads back with the new one NULL --
# ADR 0019. Everything here was replayed against a real PostgreSQL 19beta1.

statement ok
CREATE TABLE a (id int8 PRIMARY KEY, name text)

# tag: INSERT 0 2
statement ok
INSERT INTO a VALUES (1, 'one'), (2, 'two')

# tag: ALTER TABLE
statement ok
ALTER TABLE a ADD COLUMN note text

# The rows written before the column exists read back with it NULL, and nothing rewrote them.
query ITT
SELECT id, name, note FROM a ORDER BY id
----
1	one	NULL
2	two	NULL

# A second one, because one ALTER is the easy case and two is where a column count that was really
# a boolean would fall over.
# tag: ALTER TABLE
statement ok
ALTER TABLE a ADD COLUMN score int8

query ITTI
SELECT id, name, note, score FROM a ORDER BY id
----
1	one	NULL	NULL
2	two	NULL	NULL

# A row written after the ALTER carries the new columns, and the old rows still do not.
# tag: INSERT 0 1
statement ok
INSERT INTO a VALUES (3, 'three', 'hi', 42)

query ITTI
SELECT id, name, note, score FROM a ORDER BY id
----
1	one	NULL	NULL
2	two	NULL	NULL
3	three	hi	42

# `SELECT *` sees the new columns in the order they were added, which is the order they are stored
# in.
query ITTI
SELECT * FROM a ORDER BY id
----
1	one	NULL	NULL
2	two	NULL	NULL
3	three	hi	42

# The new column is writable like any other.
# tag: UPDATE 1
statement ok
UPDATE a SET score = 7 WHERE id = 1

query II
SELECT id, score FROM a ORDER BY id
----
1	7
2	NULL
3	42

# And filterable: a NULL in a column that was added is a NULL like any other.
query I
SELECT id FROM a WHERE score IS NULL
----
2

# A column that is already there is 42701, and IF NOT EXISTS makes it a notice instead.
statement error (42701)
ALTER TABLE a ADD COLUMN note text

# tag: ALTER TABLE
statement ok
ALTER TABLE a ADD COLUMN IF NOT EXISTS note text

# A missing table is 42P01, and IF EXISTS makes that one a notice too.
statement error (42P01)
ALTER TABLE nope ADD COLUMN c text

# tag: ALTER TABLE
statement ok
ALTER TABLE IF EXISTS nope ADD COLUMN c text

# An index is a relation, so PostgreSQL does not say "is not a table" -- it says the action cannot
# be performed on it.
statement error (42809)
ALTER TABLE a_pkey ADD COLUMN c text

# Several actions in one statement are one atomic change.
# tag: ALTER TABLE
statement ok
ALTER TABLE a ADD COLUMN m1 text, ADD COLUMN m2 bool

query ITB
SELECT id, m1, m2 FROM a ORDER BY id
----
1	NULL	NULL
2	NULL	NULL
3	NULL	NULL

# An index built after the ALTER covers the padded NULLs, which is the case that would break if
# the backfill decoded an old row against the new column list and failed.
# tag: CREATE INDEX
statement ok
CREATE INDEX a_score_idx ON a (score)

query I
SELECT id FROM a WHERE score = 42
----
3

# A new column takes part in a unique index like any other, NULLs included -- PostgreSQL admits
# any number of NULLs in a UNIQUE column.
# tag: CREATE INDEX
statement ok
CREATE UNIQUE INDEX a_m1_key ON a (m1)

# tag: UPDATE 1
statement ok
UPDATE a SET m1 = 'only' WHERE id = 1

statement error (23505)
UPDATE a SET m1 = 'only' WHERE id = 2

# --- a constant DEFAULT, and the rows that predate the column ------------------------------------
# PostgreSQL 11's missing value (ADR 0020, docs/plans/phase-6e.md §5 unit 1): the constant is stored
# on the *column* and the decoder pads with it, so a populated table is altered without a row being
# rewritten. ADR 0019's pad rule generalised -- that rule pads with NULL, and NULL is still what a
# column with no default pads with.

statement ok
CREATE TABLE d (id int8 PRIMARY KEY)

statement ok
INSERT INTO d VALUES (1), (2)

statement ok
ALTER TABLE d ADD COLUMN c text DEFAULT 'old'

# Rows written before the column existed read the default. No row was rewritten to make this true.
query IT rowsort
SELECT id, c FROM d
----
1	old
2	old

# A row written *after* takes the default too -- through the other field. What an INSERT omits is
# the column's default; what a narrow row is missing is its missing value, and the two are separate
# because PostgreSQL lets them diverge.
statement ok
INSERT INTO d (id) VALUES (3)

statement ok
INSERT INTO d (id, c) VALUES (4, 'given')

query IT rowsort
SELECT id, c FROM d
----
1	old
2	old
3	old
4	given

# NOT NULL with a constant default is instant, here and on a real server: the constant is what every
# row already stored holds.
statement ok
ALTER TABLE d ADD COLUMN n int8 NOT NULL DEFAULT 7

query II rowsort
SELECT id, n FROM d
----
1	7
2	7
3	7
4	7

statement error (23502)
INSERT INTO d (id, n) VALUES (5, NULL)

# And a column added with no default still pads NULL, which is where this started.
statement ok
ALTER TABLE d ADD COLUMN e text

query T rowsort
SELECT e FROM d
----
NULL
NULL
NULL
NULL

# --- DROP COLUMN: the slot stays, so rows from both sides of the drop read alike (ADR 0051) ---

statement ok
CREATE TABLE dc (id int8 PRIMARY KEY, keep text, gone int8, tail text)

statement ok
INSERT INTO dc VALUES (1, 'a', 10, 'x')

statement ok
INSERT INTO dc VALUES (2, 'b', 20, 'y')

statement ok
ALTER TABLE dc DROP COLUMN gone

# A row written after the drop, beside two written before it. If the slot were removed rather than
# tombstoned, the two old rows would carry a column the schema does not have — which decode_row
# refuses — and if the slot shifted, `tail` would read the dropped column's value.
statement ok
INSERT INTO dc VALUES (3, 'c', 'z')

query ITT rowsort
SELECT * FROM dc
----
1	a	x
2	b	y
3	c	z

# The name resolves nowhere a user can write it.
statement error (42703)
SELECT gone FROM dc

statement error (42703)
UPDATE dc SET gone = 1

# The name is free again and the slot is not: a re-added `gone` is a new column that reads NULL,
# not the int8 still sitting in the old rows' bytes.
statement ok
ALTER TABLE dc ADD COLUMN gone text

query T rowsort
SELECT gone FROM dc
----
NULL
NULL
NULL

# Several clauses in one statement, which is what `remove_columns` sends.
statement ok
ALTER TABLE dc DROP COLUMN keep, DROP COLUMN gone

query IT rowsort
SELECT * FROM dc
----
1	x
2	y
3	z

statement error (42703)
ALTER TABLE dc DROP COLUMN nosuch

statement ok
ALTER TABLE dc DROP COLUMN IF EXISTS nosuch

# --- RENAME COLUMN and RENAME TO: only the name moves, the ordinal does not ---

statement ok
CREATE TABLE rn (id int8 PRIMARY KEY, name text, qty int8)

statement ok
INSERT INTO rn VALUES (1, 'one', 10)

statement ok
CREATE INDEX index_rn_on_qty ON rn (qty)

statement ok
ALTER TABLE rn RENAME COLUMN name TO title

# The row written under the old name reads under the new one: a rename does not move the column,
# and the ordinal is what the row codec decodes at.
query ITI rowsort
SELECT id, title, qty FROM rn
----
1	one	10

statement error (42703)
SELECT name FROM rn

# A name already taken is 42701, including renaming a column to the name it already has.
statement error (42701)
ALTER TABLE rn RENAME COLUMN title TO qty

statement error (42701)
ALTER TABLE rn RENAME COLUMN title TO title

statement error (42703)
ALTER TABLE rn RENAME COLUMN nosuchcolumn TO x

# The table form, whose indexes keep their own names — which is why ActiveRecord follows it with
# an explicit rename for the sequence.
statement ok
ALTER TABLE rn RENAME TO rn2

query I rowsort
SELECT count(*) FROM rn2
----
1

query T rowsort
SELECT indexname FROM pg_indexes WHERE tablename = 'rn2'
----
index_rn_on_qty
rn_pkey

# The old name is free again, and the second table's derived key is numbered rather than refused.
statement ok
CREATE TABLE rn (id int8 PRIMARY KEY)

# Bytes captured from a real PostgreSQL 19beta1 server and a real psql 18.6 client, through
# a recording proxy. Nothing here was written by hand from the protocol specification: every
# line is what the two of them actually put on a socket. See tests/pgwire_golden.rs.
#
# name <tab> hex

# --- startup, from psql 18.6 ---
f_ssl_request	0000000804d2162f
f_startup_30	0000003900030000757365720065736b65720064617461626173650065736b6572006170706c69636174696f6e5f6e616d65007073716c0000
f_startup_32	0000003b00030002757365720074657374657200646174616261736500746573746462006170706c69636174696f6e5f6e616d65007073716c0000

# --- startup replies, from PostgreSQL 19beta1 ---
b_ssl_refused	4e
b_auth_ok	520000000800000000
b_backend_key_30	4b0000000c00000050351bd1dd
b_ready_idle	5a0000000549
b_ready_in_transaction	5a0000000554
b_ready_failed	5a0000000545
# minor 3.9 requested: newest supported 3.2, no unsupported _pq_ options
b_negotiate_no_options	760000000c0003000200000000
# 3.2 requested with an unknown _pq_.made_up_thing parameter
b_negotiate_one_option	760000001f00030002000000015f70715f2e6d6164655f75705f7468696e6700

